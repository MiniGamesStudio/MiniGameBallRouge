// 自动生成的 FlatBuffers Schema 文件
// 源工作表: Drop
// 请勿手动修改此文件

namespace Config;

/// Drop 单条记录
table Drop {
  /// 掉落规则 ID
  id:string;
  /// 来源 0全局默认 1按品质 2按类型 3按具体敌人
  sourceKind:byte;
  /// 配合来源：品质 0~5 / 类型 0~3 / 敌人 ID；全局填 *
  sourceId:string;
  /// 掉落物 0经验水晶 1超级水晶 2金币 3魂晶
  kind:byte;
  /// 概率 0~1（经验水晶固定 1.0）
  chance:float32;
  /// 数量下限
  amountMin:int32;
  /// 数量上限
  amountMax:int32;
  /// 散落半径 px（0.2 格 = 16 px）
  scatterRadius:float32;
  /// 磁吸半径 px（0 = 需手动拾取）
  magnetRadius:int32;
  /// 存活时间 秒（最后 3s 闪烁）
  lifeTime:float32;
  /// 经验水晶携带经验（0 = 按品质×类型算）
  value:int32;
  /// 备注
  desc:string;
}

/// Drop 记录列表
table DropList {
  items:[Drop];
}

root_type DropList;
