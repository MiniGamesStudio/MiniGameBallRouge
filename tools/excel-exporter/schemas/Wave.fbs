// 自动生成的 FlatBuffers Schema 文件
// 源工作表: Wave
// 请勿手动修改此文件

namespace Config;

/// Wave 单条记录
table Wave {
  /// 波次 ID
  id:string;
  /// 所属关卡 Level.id
  levelId:string;
  /// 第几波（从 1 开始）
  waveIndex:int32;
  /// 生成方式 0手写 1随机
  mode:byte;
  /// 随机模式种子（0 = 用关卡种子）
  seed:int32;
  /// 随机模式生成几个带（1 带 = 2 行 = 10 格）
  bands:int32;
  /// 6 项品质权重，如 [60,40,0,0,0,0]
  qualityWeights:[int32];
  /// 4 项类型权重，如 [78,18,3,1]
  typeWeights:[int32];
  /// 6 项体型权重 [单格,双横,双竖,四格,六格,八格]
  shapeWeights:[int32];
  /// 行入场间隔 秒
  rowSpawnInterval:float32;
  /// 带入场间隔 秒
  bandSpawnInterval:float32;
  /// 带内错峰 秒（做出逐个弹出）
  spawnStagger:float32;
  /// 覆盖默认下移速度 px/s（0 = 用难度曲线）
  fallSpeed:float32;
  /// 是否 BOSS 波
  isBossWave:bool;
  /// 备注
  desc:string;
}

/// Wave 记录列表
table WaveList {
  items:[Wave];
}

root_type WaveList;
