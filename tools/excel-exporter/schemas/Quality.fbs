namespace Config;

/// Quality 单条记录
table Quality {
  /// 品质 0白 1绿 2蓝 3紫 4金 5红
  quality:byte;
  /// 品质名
  name:string;
  /// 染色色值（UI / 掉落物染色仍可用）
  colorHex:string;
  /// 品质底图贴图名（一格一张，128×128）
  baseArt:string;
  /// 单格血量（约 ×1.65 几何递增）
  hpPerCell:int32;
  /// 生成权重（越大越常见）
  weight:int32;
  /// 单格基础经验
  exp:int32;
  /// 单格基础金币
  coin:int32;
  /// 备注
  desc:string;
}

/// Quality 记录列表
table QualityList {
  items:[Quality];
}

root_type QualityList;
