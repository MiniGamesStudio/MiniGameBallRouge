// 自动生成的 FlatBuffers Schema 文件
// 源工作表: Player
// 请勿手动修改此文件

namespace Config;

/// Player 单条记录
table Player {
  /// 主键（固定 p_default）
  id:string;
  /// 显示名
  name:string;
  /// 最大血量
  maxHp:int32;
  /// 视觉半径 px（贴图内切圆）
  visualRadius:int32;
  /// 受击判定半径 px（建议 24~28，越小越耐玩）
  hitRadius:int32;
  /// 移动速度 px/s
  moveSpeed:int32;
  /// 初始弹匣容量（需求：初始 5 发，可配置）
  bulletCount:int32;
  /// 开火间隔 秒
  fireInterval:float32;
  /// 子弹速度 px/s
  bulletSpeed:int32;
  /// 单发伤害
  bulletDamage:int32;
  /// 子弹半径 px
  bulletRadius:int32;
  /// 回收/主动接弹半径 px（建议 = hitRadius + bulletRadius）
  catchRadius:int32;
  /// 子弹最长存活 秒（超时强制回身，兜底）
  maxBulletLife:float32;
  /// 掉落物磁吸半径 px（可被技能/加点提升）
  magnetRadius:int32;
  /// 免费弹上限（僚机/分裂弹，不占弹匣）
  freeBulletMax:int32;
  /// 贴图名
  sprite:string;
  /// 备注
  desc:string;
}

/// Player 记录列表
table PlayerList {
  items:[Player];
}

root_type PlayerList;
